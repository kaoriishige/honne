# ==========================================
# アプリ基本設定
# ==========================================
NEXT_PUBLIC_APP_URL=http://localhost:3000

# ==========================================
# Firebase Client SDK（ブラウザ公開可）
# ==========================================
NEXT_PUBLIC_FIREBASE_API_KEY=your_firebase_api_key
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=your_project.firebaseapp.com
NEXT_PUBLIC_FIREBASE_PROJECT_ID=your_project_id
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=your_project.firebasestorage.app
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=your_sender_id
NEXT_PUBLIC_FIREBASE_APP_ID=your_app_id

# ==========================================
# Firebase Admin SDK（サーバー専用・絶対に公開しない）
# ==========================================
FIREBASE_ADMIN_PROJECT_ID=your_project_id
FIREBASE_ADMIN_CLIENT_EMAIL=firebase-adminsdk-xxxxx@your_project_id.iam.gserviceaccount.com
FIREBASE_ADMIN_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nYOUR_PRIVATE_KEY_HERE\n-----END PRIVATE KEY-----\n"

# ==========================================
# アプリケーション層データ暗号化鍵（サーバー専用）
# 32バイトのランダム値をBase64または64文字Hexで設定
# 生成例: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
# ==========================================
DATA_ENCRYPTION_KEY=replace_with_32byte_base64_key

# ==========================================
# OpenAI API（サーバー専用・PHASE 3で使用）
# ==========================================
OPENAI_API_KEY=sk-your_openai_api_key
OPENAI_MODEL=gpt-4o-mini

# ==========================================
# Stripe 決済（サーバー専用・絶対に公開しない）
# ==========================================
STRIPE_SECRET_KEY=sk_test_your_stripe_secret_key
STRIPE_WEBHOOK_SECRET=whsec_your_stripe_webhook_secret
STRIPE_PRICE_ID_PAID_MONTHLY=price_your_monthly_480_jpy_price_id
